  "dataGovernance": { "purposes": ["Tenant application operation"], "classifications": ["internal", "personal"], "residency": ["AU"], "retentionDays": 365, "export": "none", "deletionPolicyRef": "docs/application-packaging.md#deletion" },
  "callbacks": [],
  "commercial": { "model": "free", "termsRef": "docs/application-packaging.md#commercial" },
  "support": { "owner": "Application Owner", "slaRef": "docs/application-packaging.md#support", "runbookRef": "docs/application-packaging.md#operations" },
  "compatibility": { "platformContract": "eai.app-marketplace/v1", "minimumTemplateVersion": "0.1.0" },
  "lifecycle": { "installRef": "docs/application-packaging.md#install", "updateRef": "docs/application-packaging.md#update", "uninstallRef": "docs/application-packaging.md#uninstall", "migrationRef": "docs/application-packaging.md#migration", "rollbackRef": "docs/application-packaging.md#rollback" },
  "evidence": { "ciRef": ".eai/test-coverage.json", "securityRef": "docs/application-packaging.md#security", "tenantIsolationRef": "docs/application-packaging.md#tenant-isolation", "accessibilityRef": "docs/application-packaging.md#accessibility" }
