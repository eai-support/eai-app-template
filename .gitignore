# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.eai-build/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# environment variables
.env*
!.env.example

# npm secret overrides (use .npmrc.local for tokens)
# .npmrc itself is committed — it contains only the registry URL, no secrets
.npmrc.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

*storybook.log
/storybook-static/

# Package Hash
.last_package_hash
/last_package_hash
/.last_package_hash
.claude/settings.local.json

/packages/client/dist
/packages/client/node_modules
/packages/client/.npmrc


# VS Code
.vscode/

# Log files
*.log
mcp_sharepoint.log

# Graphify local state (portable team artifacts remain tracked)
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_cached.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_semantic_new.json
graphify-out/.graphify_chunk_*.json
graphify-out/.needs_update
graphify-out/cost.json
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
graphify-out/tmp/
graphify-out/*.bak
graphify-out/*-backup-*
graphify-out/20??-??-??/
!graphify-out/.graphify_labels.json

# Graphify hook bodies are installed per clone and are never versioned
.husky/post-commit
.husky/post-checkout
